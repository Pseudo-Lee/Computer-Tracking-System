<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="ViewLearners.aspx.cs" Inherits="CTS.ViewLearners" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Learners List</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            padding: 20px;
            margin: 0;
        }
        h1 {
            text-align: center;
            color: #0056b3;
            font-size: 36px;
            margin-bottom: 20px;
        }
        .search-container {
            text-align: center;
            margin-bottom: 20px;
        }
        .search-container input, .search-container select {
            padding: 10px;
            font-size: 16px;
            margin-right: 10px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }
        .btn {
            background-color: #0056b3;
            color: #ffffff;
            padding: 12px 24px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
            font-size: 16px;
            transition: background-color 0.3s;
        }
        .btn:hover {
            background-color: #003d7a;
        }
        .panel-container {
            text-align: center;
            margin-top: 20px;
        }
        .panel-container .filter-panel {
            display: none; /* Initially hidden */
            padding: 20px;
            border-radius: 8px;
            background-color: #e9ecef;
            border: 1px solid #ccc;
            text-align: center;
        }
        .filter-panel input {
            margin: 0 10px;
        }
        .gridview-container {
            margin: 0 auto;
            width: 90%;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            overflow: hidden;
            background-color: #ffffff;
        }
        .GridView {
            width: 100%;
            border-collapse: collapse;
        }
        .GridView th, .GridView td {
            border-bottom: 1px solid #ddd;
            padding: 12px 15px;
            text-align: left;
        }
        .GridView th {
            background-color: #e9ecef;
            color: #0056b3;
        }
        .GridView tr:nth-child(even) {
            background-color: #f2f2f2;
        }
        .GridView tr:hover {
            background-color: #e9ecef;
        }
        .label-toggle {
            cursor: pointer;
            color: #0056b3;
            text-decoration: underline;
        }
        .center {
            text-align: center;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <h1>Learners List</h1>
        <div class="search-container">
            <asp:TextBox ID="txtSearch" runat="server" placeholder="Enter search term"></asp:TextBox>
            <asp:DropDownList ID="ddlFilter" runat="server">
                <asp:ListItem Text="First Name" Value="FirstName"></asp:ListItem>
                <asp:ListItem Text="Last Name" Value="LastName"></asp:ListItem>
                <asp:ListItem Text="University" Value="University"></asp:ListItem>
                <asp:ListItem Text="ID Number" Value="IdNumber"></asp:ListItem>
            </asp:DropDownList>
            <asp:Button ID="btnLoadData" runat="server" Text="Load Learners" CssClass="btn" OnClick="btnLoadData_Click" />
        </div>
        <br />
        <div class="center">
            <asp:Button ID="AdvFilters" runat="server" Text="Show Advanced Filters" OnClick="AdvFilters_Click" CssClass="btn" />
            <asp:Button ID="HideBtn" runat="server" Text="Hide Advanced Filters" OnClick="HideBtn_Click" CssClass="btn" />
        </div>
        <div class="panel-container">
            <asp:Panel ID="filterPanel" runat="server" CssClass="filter-panel">
                <asp:CheckBox ID="chkName" runat="server" Text="Name" />
                <asp:CheckBox ID="chkSurname" runat="server" Text="Surname" />
                <asp:CheckBox ID="chkID" runat="server" Text="ID" />
                <asp:CheckBox ID="chkEmail" runat="server" Text="Email" />
                <asp:Button ID="btnApplyFilters" runat="server" Text="Apply Filters" CssClass="btn" OnClick="btnApplyFilters_Click" />
            </asp:Panel>
        </div>
        <div class="gridview-container">
            <asp:GridView ID="GridViewLearners" runat="server" AutoGenerateColumns="False" CssClass="GridView" AutoGenerateDeleteButton="True" AutoGenerateEditButton="True">
                <Columns>
                    <asp:BoundField DataField="LearnerID" HeaderText="Learner ID" />
                    <asp:BoundField DataField="FirstName" HeaderText="First Name" />
                    <asp:BoundField DataField="LastName" HeaderText="Last Name" />
                    <asp:BoundField DataField="DateOfBirth" HeaderText="Date of Birth" DataFormatString="{0:yyyy-MM-dd}" />
                    <asp:BoundField DataField="University" HeaderText="University" />
                    <asp:BoundField DataField="TelephoneNo" HeaderText="Telephone No" />
                    <asp:BoundField DataField="EmailAddress" HeaderText="Email Address" />
                    <asp:BoundField DataField="IdNumber" HeaderText="ID Number" />
                </Columns>
            </asp:GridView>
        </div>
    </form>
</body>
</html>
